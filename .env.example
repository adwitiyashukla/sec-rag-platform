# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- LLM providers -------------------------------------------------------
# Primary. Free tier, no credit card: https://console.groq.com/keys
SECRAG_GROQ_API_KEY=
# Fallback. Free tier: https://aistudio.google.com/apikey
SECRAG_GEMINI_API_KEY=

# Provider preference order. Options: groq, gemini, echo
# "echo" is a deterministic offline provider used by the test suite.
SECRAG_LLM_PROVIDERS=groq,gemini

SECRAG_GROQ_MODEL=llama-3.3-70b-versatile
SECRAG_GEMINI_MODEL=gemini-2.5-flash-lite

# --- SEC EDGAR -----------------------------------------------------------
# EDGAR requires a descriptive User-Agent with a contact address.
# See https://www.sec.gov/os/accessing-edgar-data
SECRAG_EDGAR_USER_AGENT=sec-rag-platform/0.1.0 (shuklaaw@mail.uc.edu)

# --- Retrieval tuning ----------------------------------------------------
SECRAG_DENSE_TOP_K=30
SECRAG_SPARSE_TOP_K=30
SECRAG_RRF_K=60
SECRAG_RERANK_TOP_N=6

# --- Guardrails ----------------------------------------------------------
SECRAG_MIN_GROUNDEDNESS=0.45
SECRAG_ENABLE_PII_REDACTION=true
SECRAG_ENABLE_INJECTION_DETECTION=true

# --- Semantic cache ------------------------------------------------------
SECRAG_CACHE_ENABLED=true
SECRAG_CACHE_SIMILARITY_THRESHOLD=0.96
