# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Tooling ---------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Secrets ---------------------------------------------------------------
.env
.env.local

# --- Generated artifacts ---------------------------------------------------
# The index, cached filings, and model weights are all reproducible with
# `secrag ingest`, and together run to hundreds of megabytes.
data/raw/*
data/index/*
data/cache/*
data/models/*
!data/raw/.gitkeep
!data/index/.gitkeep
!data/cache/.gitkeep
.fastembed_cache/
models/

# Evaluation reports are regenerated by the harness and by CI.
evals/reports/*
!evals/reports/.gitkeep

# --- Local run logs --------------------------------------------------------
*.log
*.err
*.out

# --- OS and editors --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
.commitmsg.txt
